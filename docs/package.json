{
  "name": "ferry-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Ferry documentation site (Fumadocs + Next.js static export)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-links.mjs",
    "start": "serve out",
    "typecheck": "next typegen && tsc --noEmit",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "check-links": "node scripts/check-links.mjs",
    "check-content": "node scripts/check-ste.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-openapi": "^12.0.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.14",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "remark-gfm": "^4.0.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
